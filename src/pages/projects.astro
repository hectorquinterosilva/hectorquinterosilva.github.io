---
import MainLayout from "../layouts/MainLayout.astro";
import { projects } from "../data/projects";

const levels = [...new Set(projects.map(project => project.level))].sort(
  (a, b) => a - b
);

const completedProjects = projects.filter(
  project => project.status === "Completed"
).length;

const inProgressProjects = projects.filter(
  project => project.status === "In Progress"
).length;

const plannedProjects = projects.filter(
  project => project.status === "Planned"
).length;
---

<MainLayout
  title="Projects | Héctor Andrés Quintero Silva"
  description="AI Platform Engineering Portfolio"
>

<section class="hero">

  <p class="eyebrow">
    Engineering Portfolio
  </p>

  <h1>
    Projects
  </h1>

  <p class="description">
    This roadmap documents my journey as an AI Platform Engineer.
    Every project is production-oriented and designed to strengthen
    backend engineering, cloud-native architectures, AI infrastructure,
    MLOps, Data Engineering and Machine Learning.
  </p>

</section>

<section>

  <div class="stats-grid">

    <div class="stat-card">

      <h3>{projects.length}</h3>

      <p>Total Projects</p>

    </div>

    <div class="stat-card">

      <h3>{completedProjects}</h3>

      <p>Completed</p>

    </div>

    <div class="stat-card">

      <h3>{inProgressProjects}</h3>

      <p>In Progress</p>

    </div>

    <div class="stat-card">

      <h3>{plannedProjects}</h3>

      <p>Planned</p>

    </div>

  </div>

</section>

{
levels.map(level => (

<section>

<h2>

Level {level}

</h2>

<div class="projects-grid">

{

projects

.filter(project => project.level === level)

.map(project => (

<div class="card">

<h3>

{project.title}

</h3>

<p class="project-status">

{project.status}

</p>

<p>

{project.description}

</p>

<br>

<div class="tech-stack">

{

project.technologies.map(tech => (

<span class="tech-pill">

{tech}

</span>

))

}

</div>

</div>

))

}

</div>

</section>

))
}

</MainLayout>
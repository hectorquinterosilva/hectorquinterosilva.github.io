---
import MainLayout from "../layouts/MainLayout.astro";
import { profile } from "../data/profile";
import { techStack } from "../data/stack";
---

<MainLayout
  title={`About | ${profile.name}`}
  description={`About ${profile.name}`}
>

  <section class="hero">

    <p class="eyebrow">
      About Me
    </p>

    <h1>
      {profile.name}
    </h1>

    <h2>
      {profile.title}
    </h2>

    <p class="description">
      {profile.summary}
    </p>

  </section>

  <section>

    <div class="section-header">

      <p class="eyebrow">
        ENGINEERING PROFILE
      </p>

      <h2>
        What I Build
      </h2>

      <p>
        Production-oriented systems designed around real engineering
        problems rather than isolated exercises.
      </p>

    </div>

    <div class="specializations-grid">

      <article class="card">

        <h3>
          Backend Systems
        </h3>

        <p>
          Scalable APIs and backend services built with Python,
          FastAPI, PostgreSQL and Redis. Focused on clean
          architecture, observability and production reliability.
        </p>

        <div class="tech-stack">
          <span class="tech-pill">Python</span>
          <span class="tech-pill">FastAPI</span>
          <span class="tech-pill">PostgreSQL</span>
          <span class="tech-pill">Redis</span>
        </div>

      </article>

      <article class="card">

        <h3>
          AI Platform Engineering
        </h3>

        <p>
          Infrastructure and services that support AI applications
          in production: LLM gateways, RAG systems, embedding
          services and agent platforms.
        </p>

        <div class="tech-stack">
          <span class="tech-pill">LLMs</span>
          <span class="tech-pill">RAG</span>
          <span class="tech-pill">Embeddings</span>
          <span class="tech-pill">Agents</span>
        </div>

      </article>

      <article class="card">

        <h3>
          Cloud & Infrastructure
        </h3>

        <p>
          Containerized, reproducible environments designed for
          deployment across local, staging and production
          configurations.
        </p>

        <div class="tech-stack">
          <span class="tech-pill">Docker</span>
          <span class="tech-pill">Kubernetes</span>
          <span class="tech-pill">AWS</span>
          <span class="tech-pill">Linux</span>
        </div>

      </article>

    </div>

  </section>

  <section>

    <h2>
      Technology Stack
    </h2>

    <div class="tech-stack">
      {
        techStack.map((stack) => (
          <span class="tech-pill">
            {stack.name}
          </span>
        ))
      }
    </div>

  </section>

  <section>

    <div class="card">

      <p class="eyebrow">
        HOW I WORK
      </p>

      <h2>
        Built through products, not tutorials.
      </h2>

      <p class="description">
        Rather than accumulating isolated exercises, every concept
        is applied to a real engineering product. The portfolio and
        roadmap are the result: a growing ecosystem of interconnected
        systems designed with production practices from day one.
      </p>

      <div class="hero-buttons">

        <a
          class="primary-button"
          href="/portfolio"
        >
          Explore the Portfolio
        </a>

        <a
          class="secondary-button"
          href="/roadmap"
        >
          View the Roadmap
        </a>

      </div>

    </div>

  </section>

</MainLayout>

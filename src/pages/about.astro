---
import MainLayout from "../layouts/MainLayout.astro";

import { profile } from "../data/profile";
import { techStack } from "../data/stack";
import { experience } from "../data/experience";
---

<MainLayout
  title={`About | ${profile.name}`}
  description={`About ${profile.name}`}
>

<section class="hero">

<p class="eyebrow">

About Me

</p>

<h1>

{profile.name}

</h1>

<h2>

{profile.title}

</h2>

<p class="description">

{profile.summary}

</p>

</section>

<section>

<h2>

Professional Experience

</h2>

<div class="projects-grid">

{

experience.map(job=>(

<div class="card">

<h3>

{job.position}

</h3>

<h4>

{job.company}

</h4>

<p>

<strong>{job.period}</strong>

<br>

{job.location}

</p>

<br>

<p>

{job.description}

</p>

<br>

<div class="tech-stack">

{

job.technologies.map(tech=>(

<span class="tech-pill">

{tech}

</span>

))

}

</div>

</div>

))

}

</div>

</section>

<section>

<h2>

Technology Stack

</h2>

<div class="tech-stack">

{

techStack.map(stack=>(

<span class="tech-pill">

{stack.name}

</span>

))

}

</div>

</section>

</MainLayout>